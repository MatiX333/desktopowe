<Window x:Class="WpfDz6.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lista produktów" Height="380" Width="520"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Label Content="Filtruj wg nazwy produktu:" VerticalAlignment="Center" Padding="0,0,10,0"/>
            <TextBox x:Name="txtFiltr" VerticalContentAlignment="Center" TextChanged="TxtFiltr_TextChanged"/>
        </DockPanel>

        <ListView x:Name="lstProdukty" Grid.Row="1" MouseDoubleClick="LstProdukty_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Symbol" Width="80" DisplayMemberBinding="{Binding Symbol}"/>

                    <GridViewColumn Header="Nazwa" Width="150" DisplayMemberBinding="{Binding Nazwa}"/>

                    <GridViewColumn Header="Liczba sztuk" Width="95">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#CCCCCC" Margin="-6,-2" Padding="6,2">
                                    <TextBlock Text="{Binding LiczbaSztuk}" 
                                               Foreground="#006600" 
                                               FontWeight="Bold" 
                                               HorizontalAlignment="Center" 
                                               TextAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Magazyn" Width="120" DisplayMemberBinding="{Binding Magazyn}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Dodaj" Width="80" Height="25" Margin="5,0" Click="BtnDodaj_Click"/>
            <Button Content="Edytuj" Width="80" Height="25" Margin="5,0" Click="BtnEdytuj_Click"/>
            <Button Content="Usuń" Width="80" Height="25" Margin="5,0" Click="BtnUsun_Click"/>
        </StackPanel>
    </Grid>
</Window>