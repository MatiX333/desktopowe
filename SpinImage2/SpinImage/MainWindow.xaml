<Window x:Class="SpinImage.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZS im. gen. Andersa" Width="1100" Height="780" MinWidth="720" MinHeight="540"
        WindowStartupLocation="CenterScreen" Background="#070B16"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- metaliczna krawędź grubej "karty" -->
        <LinearGradientBrush x:Key="EdgeBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F4F7FC" Offset="0"/>
            <GradientStop Color="#A9B5CC" Offset="0.5"/>
            <GradientStop Color="#6F7D99" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Grid x:Name="RootGrid"
          MouseEnter="Root_MouseEnter" MouseLeave="Root_MouseLeave" MouseMove="Root_MouseMove">
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.62" GradientOrigin="0.5,0.62" RadiusX="0.9" RadiusY="0.9">
                <GradientStop Color="#2E4270" Offset="0"/>
                <GradientStop Color="#16213D" Offset="0.5"/>
                <GradientStop Color="#070B16" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== TŁO: zorza + cząsteczki + winieta ===== -->
        <Canvas x:Name="AuroraLayer" Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse x:Name="Aurora1" Width="820" Height="820">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#38DC143C" Offset="0"/>
                        <GradientStop Color="#00DC143C" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse x:Name="Aurora2" Width="900" Height="900">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#483C6FD8" Offset="0"/>
                        <GradientStop Color="#003C6FD8" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>
        <Canvas x:Name="ParticleLayer" Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True"/>
        <Rectangle Grid.RowSpan="2" IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.78" RadiusY="0.78">
                    <GradientStop Color="#00050812" Offset="0.55"/>
                    <GradientStop Color="#C0050812" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ===== NAGŁÓWEK ===== -->
        <StackPanel Grid.Row="0" Margin="20,30,20,0" HorizontalAlignment="Center" IsHitTestVisible="False">
            <TextBlock x:Name="Greeting" Text="Witamy w" HorizontalAlignment="Center" Opacity="0"
                       FontFamily="Segoe UI Light" FontSize="22" Foreground="#B7C5E2">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="GreetingShift"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <TextBlock x:Name="TitleMain" Text="Zespole Szkół im. gen. Władysława Andersa"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="1000"
                       FontFamily="Georgia" FontSize="38" FontWeight="SemiBold" Opacity="0">
                <TextBlock.Foreground>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFFFFF" Offset="0"/>
                        <GradientStop Color="#C3D1F0" Offset="1"/>
                    </LinearGradientBrush>
                </TextBlock.Foreground>
                <TextBlock.Effect>
                    <DropShadowEffect Color="#6C8CE0" BlurRadius="30" ShadowDepth="0" Opacity="0.5"/>
                </TextBlock.Effect>
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="TitleShift"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <TextBlock x:Name="TitleSub" Text="w Częstochowie" HorizontalAlignment="Center" Opacity="0" Margin="0,2,0,0"
                       FontFamily="Segoe UI Light" FontSize="21" Foreground="#9FB2D8">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="SubShift"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0"
                        RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform>
                    <ScaleTransform x:Name="AccentScale" ScaleX="0"/>
                </StackPanel.RenderTransform>
                <Rectangle Width="70" Height="3" Fill="White"/>
                <Rectangle Width="70" Height="3" Fill="#DC143C"/>
            </StackPanel>
        </StackPanel>

        <!-- ===== SCENA 3D ===== -->
        <Ellipse x:Name="HaloGlow" Grid.Row="1" Width="900" Height="560" Opacity="0"
                 HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#605C7FD0" Offset="0"/>
                    <GradientStop Color="#203C5AA0" Offset="0.55"/>
                    <GradientStop Color="#003C5AA0" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Ellipse x:Name="FloorGlow" Grid.Row="1" Width="620" Height="64" Opacity="0"
                 HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,34"
                 RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="FloorScale"/>
            </Ellipse.RenderTransform>
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#908FAAE8" Offset="0"/>
                    <GradientStop Color="#00708FD0" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Viewport3D Grid.Row="1" ClipToBounds="False" RenderOptions.BitmapScalingMode="HighQuality">
            <Viewport3D.Camera>
                <PerspectiveCamera Position="0,0,4.2" LookDirection="0,0,-1" UpDirection="0,1,0" FieldOfView="50"/>
            </Viewport3D.Camera>
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <Model3DGroup>
                        <AmbientLight Color="#7C7C84"/>
                        <DirectionalLight Color="#A4A4A4" Direction="-0.25,-0.35,-1"/>

                        <Model3DGroup>
                            <Model3DGroup.Transform>
                                <Transform3DGroup>
                                    <ScaleTransform3D x:Name="ImageScale"/>
                                    <RotateTransform3D>
                                        <RotateTransform3D.Rotation>
                                            <AxisAngleRotation3D x:Name="Spin" Axis="0,1,0" Angle="0"/>
                                        </RotateTransform3D.Rotation>
                                    </RotateTransform3D>
                                    <RotateTransform3D>
                                        <RotateTransform3D.Rotation>
                                            <AxisAngleRotation3D x:Name="TiltY" Axis="0,1,0" Angle="0"/>
                                        </RotateTransform3D.Rotation>
                                    </RotateTransform3D>
                                    <RotateTransform3D>
                                        <RotateTransform3D.Rotation>
                                            <AxisAngleRotation3D x:Name="TiltX" Axis="1,0,0" Angle="0"/>
                                        </RotateTransform3D.Rotation>
                                    </RotateTransform3D>
                                    <ScaleTransform3D x:Name="IntroScale"/>
                                    <TranslateTransform3D x:Name="FloatMove"/>
                                </Transform3DGroup>
                            </Model3DGroup.Transform>

                            <!-- PRZÓD (zdjęcie) -->
                            <GeometryModel3D>
                                <GeometryModel3D.Geometry>
                                    <MeshGeometry3D Positions="-1,-1,0.035 1,-1,0.035 1,1,0.035 -1,1,0.035"
                                                    TriangleIndices="0 1 2 0 2 3"
                                                    TextureCoordinates="0,1 1,1 1,0 0,0"/>
                                </GeometryModel3D.Geometry>
                                <GeometryModel3D.Material>
                                    <DiffuseMaterial>
                                        <DiffuseMaterial.Brush>
                                            <ImageBrush x:Name="FrontBrush"/>
                                        </DiffuseMaterial.Brush>
                                    </DiffuseMaterial>
                                </GeometryModel3D.Material>
                            </GeometryModel3D>

                            <!-- TYŁ (ANDERS) -->
                            <GeometryModel3D>
                                <GeometryModel3D.Geometry>
                                    <MeshGeometry3D Positions="-1,-1,-0.035 1,-1,-0.035 1,1,-0.035 -1,1,-0.035"
                                                    TriangleIndices="0 2 1 0 3 2"
                                                    TextureCoordinates="1,1 0,1 0,0 1,0"/>
                                </GeometryModel3D.Geometry>
                                <GeometryModel3D.Material>
                                    <DiffuseMaterial>
                                        <DiffuseMaterial.Brush>
                                            <ImageBrush x:Name="BackBrush"/>
                                        </DiffuseMaterial.Brush>
                                    </DiffuseMaterial>
                                </GeometryModel3D.Material>
                            </GeometryModel3D>

                            <!-- KRAWĘDZIE (grubość karty) -->
                            <GeometryModel3D>
                                <GeometryModel3D.Geometry>
                                    <MeshGeometry3D Positions="-1,1,0.035 1,1,0.035 1,1,-0.035 -1,1,-0.035"
                                                    TriangleIndices="0 1 2 0 2 3"
                                                    TextureCoordinates="0,1 1,1 1,0 0,0"/>
                                </GeometryModel3D.Geometry>
                                <GeometryModel3D.Material>
                                    <DiffuseMaterial Brush="{StaticResource EdgeBrush}"/>
                                </GeometryModel3D.Material>
                            </GeometryModel3D>
                            <GeometryModel3D>
                                <GeometryModel3D.Geometry>
                                    <MeshGeometry3D Positions="-1,-1,-0.035 1,-1,-0.035 1,-1,0.035 -1,-1,0.035"
                                                    TriangleIndices="0 1 2 0 2 3"
                                                    TextureCoordinates="0,1 1,1 1,0 0,0"/>
                                </GeometryModel3D.Geometry>
                                <GeometryModel3D.Material>
                                    <DiffuseMaterial Brush="{StaticResource EdgeBrush}"/>
                                </GeometryModel3D.Material>
                            </GeometryModel3D>
                            <GeometryModel3D>
                                <GeometryModel3D.Geometry>
                                    <MeshGeometry3D Positions="1,-1,0.035 1,-1,-0.035 1,1,-0.035 1,1,0.035"
                                                    TriangleIndices="0 1 2 0 2 3"
                                                    TextureCoordinates="0,1 1,1 1,0 0,0"/>
                                </GeometryModel3D.Geometry>
                                <GeometryModel3D.Material>
                                    <DiffuseMaterial Brush="{StaticResource EdgeBrush}"/>
                                </GeometryModel3D.Material>
                            </GeometryModel3D>
                            <GeometryModel3D>
                                <GeometryModel3D.Geometry>
                                    <MeshGeometry3D Positions="-1,-1,-0.035 -1,-1,0.035 -1,1,0.035 -1,1,-0.035"
                                                    TriangleIndices="0 1 2 0 2 3"
                                                    TextureCoordinates="0,1 1,1 1,0 0,0"/>
                                </GeometryModel3D.Geometry>
                                <GeometryModel3D.Material>
                                    <DiffuseMaterial Brush="{StaticResource EdgeBrush}"/>
                                </GeometryModel3D.Material>
                            </GeometryModel3D>
                        </Model3DGroup>
                    </Model3DGroup>
                </ModelVisual3D.Content>
            </ModelVisual3D>
        </Viewport3D>

        <TextBlock x:Name="Hint" Grid.Row="1" Text="NAJEDŹ KURSOREM, ABY ODKRYĆ NIESPODZIANKĘ"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"
                   FontFamily="Segoe UI Semibold" FontSize="12" Foreground="#C5D3F0" Opacity="0"
                   IsHitTestVisible="False"/>
    </Grid>
</Window>
