<Window x:Class="SpinImage.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZS im. gen. Andersa" Width="900" Height="700" Background="#0A0F1E">
    <Grid MouseEnter="Viewport_MouseEnter" MouseLeave="Viewport_MouseLeave">
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.6" GradientOrigin="0.5,0.6" RadiusX="0.85" RadiusY="0.85">
                <GradientStop Color="#34476B" Offset="0"/>
                <GradientStop Color="#1B2640" Offset="0.55"/>
                <GradientStop Color="#0A0F1E" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="20,26,20,0" HorizontalAlignment="Center">
            <TextBlock Text="Witamy w" HorizontalAlignment="Center"
                       FontFamily="Segoe UI Light" FontSize="22" Foreground="#C9D3E6"/>
            <TextBlock Text="Zespole Szkół im. gen. Władysława Andersa" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap"
                       FontFamily="Georgia" FontSize="34" FontWeight="SemiBold" Foreground="White"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                <Rectangle Width="60" Height="3" Fill="White"/>
                <Rectangle Width="60" Height="3" Fill="#DC143C"/>
            </StackPanel>
        </StackPanel>

        <Viewport3D Grid.Row="1">
            <Viewport3D.Camera>
                <PerspectiveCamera Position="0,0,3.4" LookDirection="0,0,-1" UpDirection="0,1,0" FieldOfView="60"/>
            </Viewport3D.Camera>
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <Model3DGroup>
                        <AmbientLight Color="White"/>
                        <GeometryModel3D>
                            <GeometryModel3D.Geometry>
                                <MeshGeometry3D Positions="-1,-1,0 1,-1,0 1,1,0 -1,1,0"
                                                TriangleIndices="0 1 2 0 2 3"
                                                TextureCoordinates="0,1 1,1 1,0 0,0"/>
                            </GeometryModel3D.Geometry>
                            <GeometryModel3D.Material>
                                <DiffuseMaterial>
                                    <DiffuseMaterial.Brush>
                                        <ImageBrush x:Name="FrontBrush"/>
                                    </DiffuseMaterial.Brush>
                                </DiffuseMaterial>
                            </GeometryModel3D.Material>
                            <GeometryModel3D.BackMaterial>
                                <DiffuseMaterial>
                                    <DiffuseMaterial.Brush>
                                        <ImageBrush x:Name="BackBrush">
                                            <ImageBrush.RelativeTransform>
                                                <ScaleTransform ScaleX="-1" CenterX="0.5"/>
                                            </ImageBrush.RelativeTransform>
                                        </ImageBrush>
                                    </DiffuseMaterial.Brush>
                                </DiffuseMaterial>
                            </GeometryModel3D.BackMaterial>
                            <GeometryModel3D.Transform>
                                <Transform3DGroup>
                                    <ScaleTransform3D x:Name="ImageScale"/>
                                    <RotateTransform3D>
                                        <RotateTransform3D.Rotation>
                                            <AxisAngleRotation3D x:Name="Spin" Axis="0,1,0" Angle="0"/>
                                        </RotateTransform3D.Rotation>
                                    </RotateTransform3D>
                                </Transform3DGroup>
                            </GeometryModel3D.Transform>
                        </GeometryModel3D>
                    </Model3DGroup>
                </ModelVisual3D.Content>
            </ModelVisual3D>
        </Viewport3D>
    </Grid>
</Window>
