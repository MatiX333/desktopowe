<Window x:Class="kal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow"
        Height="450"
        Width="800">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>


        <!-- ROW 0 - Rozmiar tekstu -->
        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Text="Rozmiar tekstu"
                   VerticalAlignment="Center"/>

        <Slider x:Name="slider"
                Grid.Row="0"
                Grid.Column="1"
                Minimum="8"
                Maximum="64"
                Value="24"
                ValueChanged="slider_ValueChanged"
                Margin="10,5"/>


        <!-- ROW 1 - Kolor tekstu -->
        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Text="Kolor tekstu"
                   VerticalAlignment="Center"/>

        <ComboBox x:Name="TextColorComboBox"
                  Grid.Row="1"
                  Grid.Column="1"
                  Margin="10,5"
                  SelectedIndex="0"
                  SelectionChanged="ComboBox_SelectionChanged">

            <ComboBoxItem Content="Czerwony"/>
            <ComboBoxItem Content="Zielony"/>
            <ComboBoxItem Content="Niebieski"/>

        </ComboBox>


        <!-- ROW 2 - Wprowadź tekst -->
        <TextBlock Grid.Row="2"
                   Grid.Column="0"
                   Text="Wprowadź tekst"
                   VerticalAlignment="Center"/>

        <TextBox x:Name="InputTextBox"
                 Grid.Row="2"
                 Grid.Column="1"
                 Margin="10,5"
                 Text="Wprowadź tekst"
                 TextChanged="TextBox_TextChanged"/>


        <!-- ROW 3 - Ilość znaków -->
        <TextBlock Grid.Row="3"
                   Grid.Column="0"
                   Text="Ilość znaków:"
                   VerticalAlignment="Center"/>

        <TextBlock x:Name="characterCount"
                   Grid.Row="3"
                   Grid.Column="1"
                   Text="0"
                   Margin="10,5"/>


        <!-- ROW 4 - Podgląd -->
        <TextBlock x:Name="PreviewText"
                   Grid.Row="4"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   Text="Podgląd tekstu"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="24"/>

    </Grid>
</Window>
