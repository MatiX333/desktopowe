<Window x:Class="WpfDz6.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lista produktów" Height="420" Width="720"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Panel Filtrowania -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Label Content="Filtruj wg nazwy produktu:" VerticalAlignment="Center" Padding="0,0,10,0"/>
            <TextBox x:Name="txtFiltr" VerticalContentAlignment="Center" TextChanged="TxtFiltr_TextChanged"/>
        </DockPanel>

        <!-- Układ w jednym oknie: Tabela po lewej, Formularz po prawej -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="230"/>
            </Grid.ColumnDefinitions>

            <!-- Tabela produktów -->
            <ListView x:Name="lstProdukty" Grid.Column="0" SelectionChanged="LstProdukty_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Symbol" Width="75" DisplayMemberBinding="{Binding Symbol}"/>
                        <GridViewColumn Header="Nazwa" Width="130" DisplayMemberBinding="{Binding Nazwa}"/>

                        <!-- Kolumna Liczba sztuk z zielonym podświetleniem -->
                        <GridViewColumn Header="Liczba sztuk" Width="85">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#CCCCCC" Margin="-6,-2" Padding="6,2">
                                        <TextBlock Text="{Binding LiczbaSztuk}" 
                                                   Foreground="#006600" 
                                                   FontWeight="Bold" 
                                                   HorizontalAlignment="Center" 
                                                   TextAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Magazyn" Width="100" DisplayMemberBinding="{Binding Magazyn}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Panel szczegółów / edycji w tym samym oknie -->
            <GroupBox Header=" Dane produktu " Grid.Column="2" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Content="Symbol:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtSymbol" Grid.Row="0" Grid.Column="1" Margin="0,3"/>

                    <Label Content="Nazwa:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtNazwa" Grid.Row="1" Grid.Column="1" Margin="0,3"/>

                    <Label Content="Liczba sztuk:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtLiczbaSztuk" Grid.Row="2" Grid.Column="1" Margin="0,3"/>

                    <Label Content="Magazyn:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtMagazyn" Grid.Row="3" Grid.Column="1" Margin="0,3"/>

                    <!-- Przyciski akcji -->
                    <StackPanel Grid.Row="5" Grid.ColumnSpan="2">
                        <Button Content="Zapisz zmiany" Click="BtnZapisz_Click" Height="25" Margin="0,2"/>
                        <UniformGrid Columns="2" Margin="0,2">
                            <Button Content="Dodaj nowy" Click="BtnDodaj_Click" Height="25" Margin="0,0,2,0"/>
                            <Button Content="Usuń" Click="BtnUsun_Click" Height="25" Margin="2,0,0,0"/>
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</Window>