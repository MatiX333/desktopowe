<Window x:Class="kalendarz7.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:kalendarz7"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Viewbox>
        <Calendar Name="cldSample" SelectionMode="MultipleRange">
            <Calendar.BlackoutDates>
                <CalendarDateRange Start="10.13.2013" End="10.19.2013" />
                <CalendarDateRange Start="10.27.2026" End="10.31.2026" />
            </Calendar.BlackoutDates>
        </Calendar>
    </Viewbox>
</Window>
