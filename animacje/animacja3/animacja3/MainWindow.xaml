<Window x:Class="animacja3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow"
        Height="450"
        Width="900"
        Background="#2C3E50">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Button.Click" SourceName="StartButton">
            <RemoveStoryboard BeginStoryboardName="Anim"/>

            <BeginStoryboard Name="Anim">
                <Storyboard>
                    <!-- wszystkie napisy naraz (jeden element List) -->
                    <DoubleAnimation
                        Storyboard.TargetName="List"
                        Storyboard.TargetProperty="Opacity"
                        From="0" To="1"
                        Duration="0:0:0.5"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <Grid x:Name="List" Margin="40,0" Opacity="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="White"
                       Text="1. DoubleAnimation&#10;2. PointAnimation&#10;3. ColorAnimation&#10;4. SingleAnimation&#10;5. QuaternionAnimation&#10;6. ThicknessAnimation&#10;7. VectorAnimation&#10;8. Int32Animation&#10;9. RectAnimation&#10;10. MatrixAnimation&#10;11. SizeAnimation&#10;12. Point3DAnimation&#10;13. Vector3DAnimation&#10;14. Int32Animation"/>

            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="White"
                       Text="15. Int16Animation&#10;16. TransformAnimation&#10;17. BooleanAnimationBase&#10;18. ByteAnimation&#10;19. CharAnimationBase&#10;20. DecimalAnimation&#10;21. ColorAnimationUsingKeyFrames&#10;22. ThicknessAnimationUsingK...&#10;23. BooleanAnimationUsingKeyFrames&#10;24. StringAnimationUsingKeyFrames&#10;25. RectAnimationUsingKeyFrames&#10;26. SizeAnimationUsingKeyFrames&#10;27. Rotation3DAnimation&#10;28. EasingObjectKeyFrame"/>

            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="White"
                       Text="29. LinearObjectKeyFrame&#10;30. SplineObjectKeyFrame&#10;31. DiscretePointKeyFrame&#10;32. EasingPointKeyFrame&#10;33. LinearPointKeyFrame&#10;34. SplinePointKeyFrame&#10;35. DiscreteColorKeyFrame&#10;36. EasingColorKeyFrame&#10;37. LinearColorKeyFrame&#10;38. DoubleAnimationUsingKey...&#10;39. PointAnimationUsingKey...&#10;40. ColorAnimationUsingKey...&#10;41. ObjectAnimationUsingKey..."/>
        </Grid>

        <Button x:Name="StartButton"
                Content="Start"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="10"
                Padding="12,6"/>
    </Grid>
</Window>
