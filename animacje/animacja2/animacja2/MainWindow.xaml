<Window x:Class="animacja2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow"
        Height="450"
        Width="800">

    <Window.Resources>
        <SolidColorBrush x:Key="Mint" Color="#5EE6C0"/>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Button.Click" SourceName="StartButton">
            <BeginStoryboard>
                <Storyboard>
                    <ThicknessAnimation
                        Storyboard.TargetName="MyText"
                        Storyboard.TargetProperty="Margin"
                        From="0,170,0,0"
                        To="0,40,0,0"
                        Duration="0:0:0.6"/>

                    <DoubleAnimation Storyboard.TargetName="Line1" Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" BeginTime="0:0:0.6" Duration="0:0:0.4"/>

                    <DoubleAnimation Storyboard.TargetName="Text2" Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" BeginTime="0:0:1.05" Duration="0:0:0.4"/>

                    <DoubleAnimation Storyboard.TargetName="Line2" Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" BeginTime="0:0:1.5" Duration="0:0:0.4"/>

                    <DoubleAnimation Storyboard.TargetName="Text3" Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" BeginTime="0:0:1.95" Duration="0:0:0.4"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <Button x:Name="StartButton"
                Content="Start"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="10"
                Padding="12,6"/>

        <TextBlock x:Name="MyText"
                   Text="Animation"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,170,0,0"
                   FontSize="52"
                   FontWeight="Bold"
                   Foreground="{StaticResource Mint}"/>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,125,0,0">

            <Line x:Name="Line1" Y2="50" Opacity="0"
                  Stroke="{StaticResource Mint}" StrokeThickness="2"
                  StrokeDashArray="3,3" HorizontalAlignment="Center"/>

            <TextBlock x:Name="Text2" Text="Animations" Opacity="0"
                       FontSize="26" FontWeight="SemiBold"
                       Foreground="{StaticResource Mint}"
                       HorizontalAlignment="Center" Margin="0,6"/>

            <Line x:Name="Line2" Y2="50" Opacity="0"
                  Stroke="{StaticResource Mint}" StrokeThickness="2"
                  StrokeDashArray="3,3" HorizontalAlignment="Center"/>

            <TextBlock x:Name="Text3" Text="UI Element Properties" Opacity="0"
                       FontSize="26" FontWeight="SemiBold"
                       Foreground="{StaticResource Mint}"
                       HorizontalAlignment="Center" Margin="0,6"/>
        </StackPanel>
    </Grid>
</Window>
