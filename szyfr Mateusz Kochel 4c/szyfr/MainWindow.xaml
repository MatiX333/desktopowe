<Window x:Class="szyfr.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:szyfr"
        mc:Ignorable="d"
        Title="Szyfrowanie" Height="450" Width="800">

    <Grid Background="CadetBlue">

        <Label Content="Podaj wartość klucza"
               HorizontalAlignment="Left"
               Margin="40,37,0,0"
               VerticalAlignment="Top"
               Foreground="AntiqueWhite"/>

        <Label Content="Podaj Tekst"
               Foreground="AntiqueWhite"
               HorizontalAlignment="Left"
               Margin="40,175,0,0"
               VerticalAlignment="Top"/>

        <!-- KLUCZ -->
        <TextBox x:Name="txtKlucz"
                 HorizontalAlignment="Left"
                 Margin="134,88,0,0"
                 TextWrapping="Wrap"
                 VerticalAlignment="Top"
                 Width="58"/>

        <!-- TEKST DO ZASZYFROWANIA -->
        <TextBox x:Name="txtTekst"
                 HorizontalAlignment="Left"
                 Margin="40,227,0,0"
                 TextWrapping="Wrap"
                 VerticalAlignment="Top"
                 Height="159"
                 Width="205"
                 Background="White"/>

        <!-- PRZYCISK SZYFROWANIA -->
        <Button Content="Zaszyfruj"
                Background="LightBlue"
                HorizontalAlignment="Left"
                Margin="389,217,0,0"
                VerticalAlignment="Top"
                Click="Zaszyfruj_Click"/>

        <Button Content="Zapisz szyfr w pliku"
                Background="LightBlue"
                HorizontalAlignment="Left"
                Margin="578,376,0,0"
                VerticalAlignment="Top"/>

        <Label Content="Tekst zaszyfrowany"
               Foreground="AntiqueWhite"
               HorizontalAlignment="Left"
               Margin="571,37,0,0"
               VerticalAlignment="Top"/>

        <!-- WYNIK -->
        <Border BorderBrush="AntiqueWhite"
                CornerRadius="8"
                BorderThickness="2"
                Margin="516,117,51,117">

            <TextBlock x:Name="txtWynik"
                       Text=""
                       Foreground="#F0F8FF"
                       Background="Transparent"
                       TextWrapping="Wrap"
                       FontFamily="Consolas"
                       Padding="10,10,0,0"/>

        </Border>

    </Grid>
</Window>