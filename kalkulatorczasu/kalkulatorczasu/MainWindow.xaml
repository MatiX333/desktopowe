<Window x:Class="kalkulatorczasu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:kalkulatorczasu"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid RenderTransformOrigin="0.514,0.584">
        <Grid.RowDefinitions>
            <RowDefinition Height="130*"/>
            <RowDefinition Height="87*"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="pod_min" HorizontalAlignment="Left" Margin="129,14,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" Height="18" TextChanged="pod_min_TextChanged"/>
        <Label Content="Podaj liczbe minut:" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="152" Height="26"/>
        <TextBox x:Name="pod_godz" HorizontalAlignment="Left" Margin="129,45,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" Height="18"/>
        <Label Content="Podaj liczbe godzin:" HorizontalAlignment="Left" Margin="10,41,0,0" VerticalAlignment="Top" Width="152" Height="26"/>
        <Button Content="Przelicz!" Foreground="#fff" Background="#010101" HorizontalAlignment="Left" Margin="161,80,0,0" VerticalAlignment="Top" Height="27" Width="88" Click="Button_Click"/>
        <TextBlock x:Name="wynik_1" HorizontalAlignment="Left" Margin="18,121,0,0" TextWrapping="Wrap" Text="" Background="#d2d2d2" VerticalAlignment="Top" Height="71" Width="231"/>
        <Frame BorderBrush="#000" BorderThickness="1" RenderTransformOrigin="0.49,0.915" Margin="280,14,10,5" />
        <Label Content="Kalkulator czasu" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Margin="439,14,0,0" VerticalAlignment="Top" Width="192" Height="26"/>
        <Label Content="Podaje:&#xD;&#xA;" HorizontalAlignment="Left" Margin="411,45,0,0" VerticalAlignment="Top" Width="153" Height="27"/>
        <TextBox x:Name="tb_wartosc" HorizontalAlignment="Left" Margin="530,80,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" Height="18"/>
        <Label Content="Podaj ilosc czasu:" HorizontalAlignment="Left" Margin="411,76,0,0" VerticalAlignment="Top" Width="153" Height="26"/>
        <Button Content="Przelicz!" Foreground="#fff" Background="#010101" HorizontalAlignment="Left" Margin="562,0,0,0" VerticalAlignment="Center" Height="26" Width="88" Click="Button_Click_1"/>
        <TextBlock x:Name="wynik_2" HorizontalAlignment="Left" Margin="419,156,0,0" TextWrapping="Wrap" Text="" Background="#d2d2d2" VerticalAlignment="Top" Height="72" Width="231"/>
        <ComboBox x:Name="cb_wybor" HorizontalAlignment="Left" Margin="530,48,0,0" VerticalAlignment="Top" Width="120" Height="19">
            <ComboBoxItem IsSelected="True">Godziny</ComboBoxItem>
            <ComboBoxItem>Minuty</ComboBoxItem>
        </ComboBox>
    </Grid>
</Window>
