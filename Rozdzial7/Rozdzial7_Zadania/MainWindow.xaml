<Window x:Class="Rozdzial7_Zadania.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edycja produktów" Height="480" Width="740" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="Srodek" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
        <Style x:Key="SrodekPrawa" TargetType="TextBlock" BasedOn="{StaticResource Srodek}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
    </Window.Resources>
    <Grid>
        <DataGrid x:Name="gridProdukty" AutoGenerateColumns="False" CanUserAddRows="False"
                  Margin="10" RowHeight="48"
                  GridLinesVisibility="None" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}"
                                    ElementStyle="{StaticResource Srodek}"/>
                <DataGridTextColumn Header="Nazwa" Binding="{Binding Nazwa}" Width="*"
                                    ElementStyle="{StaticResource Srodek}"/>
                <DataGridTextColumn Header="Liczba sztuk" Binding="{Binding LiczbaSztuk}"
                                    ElementStyle="{StaticResource SrodekPrawa}"/>
                <DataGridComboBoxColumn x:Name="nazwaMagazynu" Header="Magazyn"
                                        SelectedItemBinding="{Binding Magazyn}"/>
                <DataGridTemplateColumn Header="Zdjęcie" Width="70" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding Zdjecie}" Height="42" Margin="2" Stretch="Uniform"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>

            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="10" VerticalAlignment="Center" Text="Opis produktu:"/>
                        <TextBox Margin="10" Text="{Binding Opis, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap" FontWeight="Bold" Foreground="BlueViolet" Width="220"/>
                        <Button x:Name="btnZdjecie" Margin="10" Click="btnZdjecie_Click"
                                Content="Dodaj lub zmień zdjęcie" Height="30" Padding="10,0"/>
                    </StackPanel>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>

            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                        <Expander>
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Magazyn:" Margin="5"/>
                                                    <TextBlock Text="{Binding Path=Name}" Margin="5"
                                                               FontWeight="Bold" Foreground="Blue"/>
                                                    <TextBlock Text="Liczba produktów:" Margin="5"/>
                                                    <TextBlock Text="{Binding Path=ItemCount}" Margin="5"
                                                               FontWeight="Bold" Foreground="Blue"/>
                                                </StackPanel>
                                            </Expander.Header>
                                            <ItemsPresenter/>
                                        </Expander>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </DataGrid.GroupStyle>
        </DataGrid>
    </Grid>
</Window>
